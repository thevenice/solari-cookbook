# Required — grab one at https://console.getsolari.com (API Keys tab)
SOLARI_API_KEY=slr_live_...

# --- Guardrails (all optional; these are the defaults) ---

# Refuse to open more than this many live sessions at once. The first line of
# defence against an agent that loops.
SOLARI_MCP_MAX_SESSIONS=3

# Reap a session after this long with no tool call against it.
SOLARI_MCP_IDLE_MS=300000

# Hard ceiling on total session lifetime, regardless of activity. Solari's own
# `timeoutMs` is a ROLLING idle window — an agent that polls a session keeps
# resetting it, so the built-in timeout can never fire. This is the deadline
# that actually fires.
SOLARI_MCP_MAX_SESSION_MS=1800000

# How often the reaper sweeps.
SOLARI_MCP_SWEEP_MS=20000

# Max characters of page text / command output returned to the model.
SOLARI_MCP_MAX_CHARS=8000
